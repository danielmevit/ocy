---
// One still frame of an exercise illustration, light and dark, inlined.
interface Props { id: string; frame: number; label?: string }
const { id, frame, label } = Astro.props;
const svgModules = import.meta.glob('../../../assets/illustrations/ocy-v1f/svg/*.svg', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const pick = (theme: string) => {
  const hit = Object.entries(svgModules).find(([k]) => k.endsWith(`/${id}-${theme}-f${frame}.svg`));
  if (!hit) throw new Error(`Missing SVG frame ${id}-${theme}-f${frame}`);
  return hit[1];
};
---
<span class="art-frame" role={label ? 'img' : undefined} aria-label={label}>
  <span class="mascot-light" aria-hidden="true" set:html={pick('light')} />
  <span class="mascot-dark" aria-hidden="true" set:html={pick('dark')} />
</span>
