---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageHref, t } from '../lib/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = pageHref(base, lang, 'home');
const pageTitle = t(lang, 'notFound.meta.title');
const pageDescription = t(lang, 'notFound.meta.description');
---

<BaseLayout
  lang={lang}
  pageType="404"
  title={pageTitle}
  description={pageDescription}
  noindex={true}
  includeOgImage={false}
>
  <section class="prose-band" aria-labelledby="not-found-heading">
    <div class="section-head">
      <h1 id="not-found-heading">{t(lang, 'notFound.heading')}</h1>
      <p class="section-sub">{t(lang, 'notFound.sub')}</p>
    </div>

    <div class="btn-row" style="margin-top: 20px;">
      <a class="btn btn-accent" href={homeHref}>{t(lang, 'notFound.homeCta')}</a>
      <a class="btn btn-outline" href="https://github.com/danielmevit/ocy">{t(lang, 'notFound.githubCta')}</a>
    </div>
  </section>
</BaseLayout>
