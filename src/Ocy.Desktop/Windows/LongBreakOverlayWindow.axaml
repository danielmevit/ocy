<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Ocy.Desktop.Controls"
        x:Class="Ocy.Desktop.Windows.LongBreakOverlayWindow"
        Topmost="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Window.Styles>
        <!-- Accent is reserved for the progress bar and the keyboard focus ring. -->
        <Style Selector="Button">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderThickness="2"
                            BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="8"
                            Margin="-3" />
                </FocusAdornerTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Panel x:Name="RootPanel" Background="{DynamicResource OverlayBrush}">
        <Border x:Name="CardBorder"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                Padding="24"
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000">
            <StackPanel>
                <TextBlock x:Name="CountdownLabelText"
                           FontSize="12"
                           FontWeight="Regular"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock x:Name="CountdownText"
                           FontSize="56"
                           FontWeight="Light"
                           FontFeatures="tnum"
                           LineHeight="64"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBlock x:Name="TitleText"
                           Margin="0,16,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText"
                           Margin="0,2,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="SuggestionsPanel" Margin="0,16,0,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid x:Name="SuggestionsGrid"
                          Margin="0,10,0,0"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16">
                        <Grid x:Name="Suggestion1Panel" Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto,*">
                            <ctl:ExerciseIllustration x:Name="Suggestion1Illustration"
                                                      Grid.Column="0"
                                                      Size="40"
                                                      VerticalAlignment="Top"
                                                      Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="Suggestion1Title"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="Suggestion1Body"
                                           FontSize="13"
                                           LineHeight="18"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="Suggestion2Panel" Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,*">
                            <ctl:ExerciseIllustration x:Name="Suggestion2Illustration"
                                                      Grid.Column="0"
                                                      Size="40"
                                                      VerticalAlignment="Top"
                                                      Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="Suggestion2Title"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="Suggestion2Body"
                                           FontSize="13"
                                           LineHeight="18"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>

                <Grid x:Name="FooterGrid" Margin="0,16,0,0" ColumnDefinitions="*,Auto">
                    <ProgressBar x:Name="BreakProgressBar"
                                 Grid.Column="0"
                                 Height="3"
                                 MinHeight="0"
                                 MinWidth="0"
                                 CornerRadius="1.5"
                                 Minimum="0"
                                 Maximum="100"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource ProgressBarTrackBrush}" />
                    <Button x:Name="SkipButton"
                            Grid.Column="1"
                            Classes="outline"
                            Margin="16,0,0,0"
                            Padding="12,5"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>
    </Panel>
</Window>
