---
import '../styles/global.css';
import faviconSvg from '../../../assets/icons/brand/ocy-sprout-light.svg?url';
import sproutLight from '../../../assets/icons/brand/ocy-sprout-light.svg?url';
import sproutDark from '../../../assets/icons/brand/ocy-sprout-dark.svg?url';
import faviconPng from '../../../assets/icons/brand/png/ocy-sprout-light-32.png?url';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  includeOgImage?: boolean;
  ogImageAlt?: string;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  includeOgImage = true,
  ogImageAlt = 'Ocy, a calm break reminder for your eyes on Windows, showing its sprout mascot and a short eye-exercise card.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = (Astro.site ? Astro.site.toString() : 'https://danielmevit.github.io').replace(/\/$/, '');
const cleanPath = !canonicalPath ? '/' : canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = canonicalPath === undefined ? undefined : `${origin}${base}${cleanPath}`;
const ogImageUrl = `${origin}${base}/assets/og.png`;
const repoUrl = 'https://github.com/danielmevit/ocy';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme before first paint: 'light' | 'dark' from localStorage, otherwise follow the OS (no attribute).
      try {
        var t = localStorage.getItem('ocy-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link
      rel="alternate"
      type="text/plain"
      href={`${base}/llms.txt`}
      title="LLM Summary"
    />

    <meta name="description" content={description} />
    <meta name="author" content="Daniel Mevit" />
    <meta name="theme-color" content="#F6F7F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17191A" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Ocy" />
    {includeOgImage && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
      </>
    )}
    <meta name="twitter:card" content={includeOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a class="brand" href={`${base}/`}>
          <img class="mascot-light" src={sproutLight} alt="" width="28" height="28" /><img class="mascot-dark" src={sproutDark} alt="" width="28" height="28" />
          <span>Ocy</span>
        </a>
        <div class="nav-links">
          <a class="nav-hide-sm" href={`${base}/#works`}>How it works</a>
          <a class="nav-hide-sm" href={`${base}/#exercises`}>Exercises</a>
          <a class="nav-hide-sm" href={`${base}/#app`}>The app</a>
          <a class="nav-hide-sm" href={`${base}/#faq`}>FAQ</a>
          <a href={repoUrl}>GitHub</a>
          <a class="nav-cta" href={`${repoUrl}/releases`}>Download</a>
          <button type="button" class="theme-btn" data-theme-btn aria-label="Theme: Auto, follows your system. Switch to Light.">
            <svg class="theme-glyph" viewBox="0 0 24 24" aria-hidden="true">
              <g class="g-auto"><path class="ink" d="M12 3.4 C7 3.2 3.3 7.2 3.5 12.2 C3.7 16.9 7.4 20.6 12.1 20.5" /><path class="ink" d="M12 3.4 C16.8 3.6 20.6 7.3 20.4 12.3 C20.2 16.9 16.7 20.4 12.1 20.5" /><path d="M12 3.6 C16.6 3.8 20.3 7.4 20.2 12.2 C20 16.7 16.6 20.2 12.1 20.3 Z" fill="currentColor" /></g>
              <g class="g-light"><path class="ink" d="M12.2 8.1 C9.8 8 8 10 8.1 12.2 C8.3 14.4 10 16 12.1 15.9 C14.3 15.8 16 14.1 15.9 12 C15.8 9.9 14.3 8.2 12.2 8.1Z" /><path class="ink" d="M12 2.8 L12.2 5 M12.1 19.1 L12 21.3 M2.9 12.1 L5.1 12 M18.9 12.2 L21.1 12 M5.4 5.6 L6.9 7.1 M17.2 17 L18.6 18.5 M18.5 5.5 L17 7 M6.9 17.1 L5.5 18.4" /></g>
              <g class="g-dark"><path class="ink" d="M15.8 3.9 C11 3.4 7 7.4 7.4 12.3 C7.8 16.8 11.6 20.3 16.2 19.9 C17.6 19.8 18.8 19.3 19.9 18.6 C15.6 18.4 12.4 15 12.5 10.8 C12.6 7.8 13.9 5.3 15.8 3.9Z" /></g>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-btn]');
        if (!btn) return;
        const root = document.documentElement;
        const order = ['auto', 'light', 'dark'];
        const names = { auto: 'Auto, follows your system', light: 'Light', dark: 'Dark' };
        const nextName = { auto: 'Light', light: 'Dark', dark: 'Auto' };
        const current = () => root.getAttribute('data-theme') || 'auto';
        const label = () => {
          const c = current();
          btn.setAttribute('aria-label', `Theme: ${names[c]}. Switch to ${nextName[c]}.`);
          btn.setAttribute('title', `Theme: ${names[c]}`);
          btn.setAttribute('data-state', c);
        };
        btn.addEventListener('click', () => {
          const n = order[(order.indexOf(current()) + 1) % order.length];
          if (n === 'auto') root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', n);
          try {
            if (n === 'auto') localStorage.removeItem('ocy-theme');
            else localStorage.setItem('ocy-theme', n);
          } catch (e) {}
          label();
        });
        label();
      })();
    </script>

    <footer class="site-footer">
      <div>
        &copy; 2026 <a href="https://github.com/danielmevit">Daniel Mevit</a> &middot; Made by
        <a href="https://damt.xyz">damt.xyz</a>
      </div>
      <div class="footer-links">
        <a href={repoUrl}>GitHub</a>
        <a href={`${repoUrl}/releases`}>Releases</a>
        <a href={`${repoUrl}/blob/main/CHANGELOG.md`}>Changelog</a>
        <a href={`${repoUrl}/blob/main/LICENSE`}>License</a>
        <a href={`${base}/privacy/`}>Privacy</a>
      </div>
    </footer>
  </body>
</html>
