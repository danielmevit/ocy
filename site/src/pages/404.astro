---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = 'Page not found — Ocy';
const pageDescription = 'That page could not be found. Return to the Ocy home page.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/404.html"
  noindex={true}
  includeOgImage={false}
>
  <section class="prose-band" aria-labelledby="not-found-heading">
    <div class="section-head">
      <h1 id="not-found-heading">Page not found</h1>
      <p class="section-sub">The link may have moved, or the address might have a typo.</p>
    </div>

    <div class="btn-row" style="margin-top: 16px;">
      <a class="btn btn-accent" href={`${base}/`}>Back to Ocy home</a>
      <a class="btn btn-outline" href="https://github.com/danielmevit/ocy">View on GitHub</a>
    </div>
  </section>
</BaseLayout>
