---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExerciseMascot from '../components/ExerciseMascot.astro';
import ArtFrame from '../components/ArtFrame.astro';
import { readAppVersion, readExercises } from '../lib/ocyData';
import { readPngSize } from '../lib/pngSize';
import trayActiveL from '../../../assets/icons/tray/light/tray-active.svg?url';
import trayPausedL from '../../../assets/icons/tray/light/tray-paused.svg?url';
import trayBreakL from '../../../assets/icons/tray/light/tray-onbreak.svg?url';
import trayAttnL from '../../../assets/icons/tray/light/tray-attention.svg?url';
import trayActiveD from '../../../assets/icons/tray/dark/tray-active.svg?url';
import trayPausedD from '../../../assets/icons/tray/dark/tray-paused.svg?url';
import trayBreakD from '../../../assets/icons/tray/dark/tray-onbreak.svg?url';
import trayAttnD from '../../../assets/icons/tray/dark/tray-attention.svg?url';

const version = readAppVersion();
const exercises = readExercises();

// site-only art (scripts/make-art.mjs): 3 line-boil variants per theme, each with open and closed eyes
const artModules = import.meta.glob('../art/*/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const boil = (name: string) =>
  [1, 2, 3].map((v) => ({
    light: artModules[`../art/${name}/ocy-${name}-light-v${v}.svg`],
    dark: artModules[`../art/${name}/ocy-${name}-dark-v${v}.svg`],
  }));
const heroArt = boil('hero');
const faqArt = boil('faq');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repoUrl = 'https://github.com/danielmevit/ocy';
const releasesUrl = `${repoUrl}/releases`;

const whyLines: Record<string, string> = {
  blink: 'Screens make us blink less. Slow, full blinks spread fresh tears across your eyes.',
  'look-left-right': 'A change from holding your eyes in one fixed position.',
  'look-up-down': 'Uses the up-and-down range your eyes hardly touch while reading a screen.',
  roll: 'Slow circles take your eyes through their full range, then let them rest.',
  'close-tight': 'A gentle squeeze and release relaxes the muscles around your eyes.',
  'near-far': 'Changing focus gives your eyes a break from screen distance.',
  'window-far': 'Looking far away lets your eyes relax from close-up focus.',
  'figure-eight': 'A slow, smooth path keeps your eyes moving without strain.',
  palming: 'A warm, dark moment with no screen light, for tired eyes.',
  'stretch-arms': 'Opens your chest and shoulders after leaning toward a screen.',
  'neck-shoulders': 'Eases the tension that builds in your neck and shoulders while you sit.',
  'stand-walk': 'A few steps get you moving and change your posture.',
};

const moments = [
  { art: 'blink', frame: 1, title: 'You’re working', line: 'Only time at your PC counts.', alt: 'Ocy looking at the screen' },
  { art: 'stand-walk', frame: 3, title: 'You step away', line: 'That is your break. No break waiting when you’re back.', alt: 'Ocy walking away from its chair' },
  { art: 'blink', frame: 3, title: 'Fullscreen or presenting', line: 'It waits until you’re done.', alt: 'Ocy waiting calmly with closed eyes' },
  { art: 'look-up-down', frame: 1, title: 'A break is due', line: 'On the screen you’re using. The others get a soft frame.', alt: 'Ocy looking up, alert' },
];

const trayStates = [
  { label: 'Running', light: trayActiveL, dark: trayActiveD, alt: 'Tray icon while Ocy is running' },
  { label: 'Paused', light: trayPausedL, dark: trayPausedD, alt: 'Tray icon while breaks are paused' },
  { label: 'On a break', light: trayBreakL, dark: trayBreakD, alt: 'Tray icon during a break' },
  { label: 'Long break soon', light: trayAttnL, dark: trayAttnD, alt: 'Tray icon when a long break is coming up', warn: true },
];

const pageTitle = 'Ocy — a calm break reminder for your eyes (free, open source)';
const pageDescription =
  'Free, open-source break reminder for Windows to ease eye strain. Short eye exercises every few minutes, a real hourly break, no account or telemetry.';

const shot = (file: string) => {
  const dims = readPngSize(`assets/screens/light/${file}.png`);
  return {
    light: `${base}/assets/screens/light/${file}.png`,
    dark: `${base}/assets/screens/dark/${file}.png`,
    w: dims ? Math.round(dims.width / 2) : undefined,
    h: dims ? Math.round(dims.height / 2) : undefined,
  };
};
const scenes = [
  {
    id: 'short',
    tab: 'Short break',
    note: 'A small card on the monitor you’re using. Your other screen gets a soft green frame.',
    img: shot('short-break'),
    alt: 'Short break card on the main monitor: Look left and right, with Ocy and a progress bar',
  },
  {
    id: 'long',
    tab: 'Long break',
    note: 'Every hour, the screen dims for a real five-minute break.',
    img: shot('long-break'),
    alt: 'Long break over a dimmed screen: Back to your screen in 4:12, Time to step away, with two suggestions',
  },
  {
    id: 'warning',
    tab: 'Warning',
    note: 'A minute before a long break: start it now, postpone or skip.',
    img: shot('warning'),
    alt: 'Warning card: Long break in 0:42, with Start now, Postpone and Skip',
  },
  {
    id: 'settings',
    tab: 'Settings',
    note: 'Changes apply right away. Light and dark follow Windows.',
    img: shot('settings'),
    alt: 'Ocy settings window with short break, long break and behaviour options',
  },
];

const defaultsRows = [
  ['Short break', 'every 10 min, for 15 s'],
  ['Long break', 'every 60 min, for 5 min'],
  ['Warning before a long break', '60 s'],
  ['Postpone', '3 min, up to 3 times'],
  ['You count as away after', '2 min without input'],
];

const faqs: { q: string; a: string; table?: boolean }[] = [
  {
    q: 'Is Ocy an alternative to EyeLeo?',
    a: 'Yes. If you used EyeLeo, which hasn’t been updated in years, Ocy covers the same daily routine: short eye exercises, regular long breaks and quiet during fullscreen work. It also shows breaks on the monitor you are using, counts time away as rest, and is built to run on Windows, macOS and Linux. Ocy is an independent project, and its code, exercises and art are all original.',
  },
  {
    q: 'Windows warns me when I first run it — is it safe?',
    a: 'Ocy isn’t code-signed yet, so Windows SmartScreen may warn on the first run. Choose More info, then Run anyway. The code is open on GitHub.',
  },
  {
    q: 'How do I start it with Windows, or remove it?',
    a: 'Turn on Start with system in Settings. To remove Ocy, quit it from the tray and delete its folder, plus %APPDATA%\\Ocy if you also want to remove your settings.',
  },
  {
    q: 'What are the defaults?',
    a: 'Short break every 10 min, for 15 s. Long break every 60 min, for 5 min. Warning 60 s before a long break. Postpone 3 min, up to 3 times. You count as away after 2 min without input. All of it is adjustable in Settings.',
    table: true,
  },
  { q: 'Is it free?', a: 'Yes. Ocy is free and open source under AGPL-3.0, with no paid tier and no ads.' },
  { q: 'Does it need the internet?', a: 'No. Ocy has no network code at all. It works fully offline and never phones home.' },
  {
    q: 'Will it interrupt my game, video call or presentation?',
    a: 'Fullscreen apps and presentations hold breaks until you are done. Detecting calls in windowed apps is on the roadmap.',
  },
  {
    q: 'Can I make it stricter or gentler?',
    a: 'Yes. Change how often breaks come and how long they last, or turn off postponing and skipping with strict mode.',
  },
  {
    q: 'Is this medical advice?',
    a: 'No. Ocy is a habit tool. If your eyes hurt or your vision changes, see an eye-care professional.',
  },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ocy',
  description: pageDescription,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Windows 10, Windows 11',
  softwareVersion: version,
  url: 'https://danielmevit.github.io/ocy/',
  downloadUrl: releasesUrl,
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Daniel Mevit', url: 'https://github.com/danielmevit' },
  publisher: { '@type': 'Organization', name: 'damt.xyz', url: 'https://damt.xyz' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <div class="hero-titles">
        <h1 id="hero-heading">A calm break reminder for your eyes</h1>
        <svg class="hero-underline" viewBox="0 0 360 16" aria-hidden="true" preserveAspectRatio="none">
          <path class="ink" d="M4 10 C 60 5, 120 12, 180 8 S 300 4, 356 9" />
        </svg>
        <p class="hero-sub">
          Short eye exercises every few minutes, a real break every hour, and quiet when you need focus.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn-accent" href={releasesUrl}>Download for Windows</a>
        <a class="btn btn-outline" href={repoUrl}>View on GitHub</a>
      </div>
      <p class="hero-meta">
        Windows 10 and 11 &middot; v{version} alpha &middot; Free, AGPL-3.0 &middot; No account, no telemetry
      </p>
    </div>

    <div class="hero-stage">
      <svg class="hero-deco" viewBox="0 0 600 500" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <path class="ink ink-dash" d="M70 430 C 140 486, 270 498, 360 480" />
        <path class="ink" d="M500 70 l 12 -14 M518 88 l 18 -6 M486 58 l 2 -18" />
      </svg>
      <div class="hero-figure" data-hero>
        <div class="disc disc-hero">
          <div class="hero-follow boil" data-boil role="img" aria-label="Ocy, a small green sprout, looking around">
            {heroArt.map((v, i) => (
              <span class="boil-v" data-on={i === 0 ? 'true' : undefined} aria-hidden="true">
                <span class="mascot-light" set:html={v.light} />
                <span class="mascot-dark" set:html={v.dark} />
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="works" class="section works" aria-labelledby="works-heading">
    <div class="section-head">
      <h2 id="works-heading">It works around you</h2>
    </div>
    <ol class="moments">
      <svg class="moments-path" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
        <path class="ink ink-dash" vector-effect="non-scaling-stroke" d="M40 30 C 180 6, 300 54, 500 30 S 820 6, 960 30" />
      </svg>
      {moments.map((m, i) => (
        <li class="moment">
          <span class="disc disc-moment">
            <ArtFrame id={m.art} frame={m.frame} label={m.alt} />
          </span>
          <span class="moment-num" aria-hidden="true">{i + 1}</span>
          <h3>{m.title}</h3>
          <p>{m.line}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="exercises" class="band exercises" aria-labelledby="exercises-heading">
    <div class="section-head">
      <h2 id="exercises-heading">Twelve tiny exercises</h2>
      <p class="section-sub">Hand-drawn, a few frames each, like a flip book.</p>
    </div>
    <div class="slideshow" data-slideshow>
      <div class="slides" aria-roledescription="carousel" aria-label="Exercises">
        {exercises.map((ex, i) => (
          <div
            class="slide"
            data-slide={String(i)}
            data-active={i === 0 ? 'true' : undefined}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${exercises.length}: ${ex.title}`}
          >
            <span class="disc disc-slide">
              <ExerciseMascot
                id={ex.id}
                frames={ex.frames}
                sequence={ex.sequence}
                stepMs={ex.stepMs}
                frozen={ex.frozen}
                label={`Ocy demonstrating: ${ex.title}`}
                size="slide"
              />
            </span>
            <div class="slide-text">
              <span class="slide-count">{String(i + 1).padStart(2, '0')} / {exercises.length}</span>
              <h3>{ex.title}</h3>
              <p>{whyLines[ex.id]}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="rail" role="group" aria-label="Choose an exercise">
        {exercises.map((ex, i) => (
          <button
            type="button"
            class="thumb"
            data-go={String(i)}
            aria-label={ex.title}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span class="disc disc-thumb"><ArtFrame id={ex.id} frame={ex.frozen} /></span>
          </button>
        ))}
      </div>
      <p class="visually-hidden" aria-live="polite" data-announce></p>
    </div>
  </section>

  <section id="app" class="section app" aria-labelledby="app-heading">
    <div class="app-side">
      <div class="section-head">
        <h2 id="app-heading">The real app</h2>
        <p class="section-sub">Follows your Windows light or dark theme.</p>
      </div>
      <div class="tabs" role="tablist" aria-label="App screens">
        {scenes.map((s, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${s.id}`}
            aria-controls={`scene-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={s.id}
          >
            {s.id === 'warning' && <span class="clay-sq" aria-hidden="true" />}
            <span>{s.tab}</span>
          </button>
        ))}
      </div>
      {scenes.map((s, i) => (
        <p class="scene-note" data-note={s.id} hidden={i !== 0}>{s.note}</p>
      ))}
    </div>

    <div class="desk">
      {scenes.map((s, i) => (
        <div
          class={`scene scene-${s.id}`}
          id={`scene-${s.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${s.id}`}
          hidden={i !== 0}
        >
          <div class="monitors">
            <div class="monitor monitor-main">
              <div class="screen">
                <span class="wall" aria-hidden="true" />
                <span class={`shot shot-${s.id}`}>
                  <img class="mascot-light" src={s.img.light} alt={s.alt} width={s.img.w} height={s.img.h} loading="lazy" decoding="async" />
                  <img class="mascot-dark" src={s.img.dark} alt={s.alt} width={s.img.w} height={s.img.h} loading="lazy" decoding="async" />
                </span>
                <span class="taskbar" aria-hidden="true" />
              </div>
              <span class="stand" aria-hidden="true" />
            </div>
            {(s.id === 'short' || s.id === 'warning') && (
              <div class="monitor monitor-side" aria-hidden="true">
                <div class="screen framed">
                  <span class="wall" />
                </div>
                <span class="stand" />
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="tray" class="band tray-band" aria-labelledby="tray-heading">
    <div class="tray">
      <div class="section-head">
        <h2 id="tray-heading">Lives in your tray</h2>
        <p class="section-sub">A small sprout that matches your taskbar. Right-click for settings, pause and quit.</p>
      </div>
      <ul class="tray-strip">
        {trayStates.map((s) => (
          <li>
            <span class="tray-icon">
              <img class="mascot-light" src={s.light} alt={s.alt} width="32" height="32" />
              <img class="mascot-dark" src={s.dark} alt={s.alt} width="32" height="32" />
            </span>
            <span class="tray-label">
              {s.warn && <span class="clay-sq" aria-hidden="true" />}
              {s.label}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="install" class="section" aria-labelledby="install-heading">
    <div class="section-head">
      <h2 id="install-heading">Install in a minute</h2>
      <p class="section-sub">Windows 10 or 11, 64-bit. A portable ZIP, no installer.</p>
    </div>
    <ol class="steps">
      <svg class="steps-path" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <path class="ink ink-dash" vector-effect="non-scaling-stroke" d="M10 20 C 180 4, 300 34, 500 20 S 820 6, 990 20" />
      </svg>
      <li class="step">
        <span class="step-num" aria-hidden="true">1</span>
        <h3>Download the ZIP</h3>
        <p><code>Ocy-{version}-win-x64.zip</code> from <a href={releasesUrl}>Releases</a></p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">2</span>
        <h3>Unzip and run</h3>
        <p>Anywhere, then open <code>Ocy.exe</code></p>
      </li>
      <li class="step">
        <span class="step-num" aria-hidden="true">3</span>
        <h3>Find the sprout</h3>
        <p>In your tray. Right-click for settings.</p>
      </li>
    </ol>
  </section>

  <section id="faq" class="band faq" aria-labelledby="faq-heading">
    <div class="faq-main">
      <div class="section-head">
        <h2 id="faq-heading">Questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            {item.table ? (
              <div class="faq-answer">
                <table class="defaults-table">
                  <tbody>
                    {defaultsRows.map(([k, v]) => (
                      <tr>
                        <th scope="row">{k}</th>
                        <td>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p>All of it is adjustable in Settings, without a restart.</p>
              </div>
            ) : item.q.startsWith('How do I start') ? (
              <p>
                Turn on <strong>Start with system</strong> in Settings. To remove Ocy, quit it from the tray and delete
                its folder, plus <code>%APPDATA%\Ocy</code> if you also want to remove your settings.
              </p>
            ) : item.q.startsWith('Windows warns') ? (
              <p>
                Ocy isn&rsquo;t code-signed yet, so Windows SmartScreen may warn on the first run. Choose{' '}
                <strong>More info &rarr; Run anyway</strong>. The code is open on <a href={repoUrl}>GitHub</a>.
              </p>
            ) : (
              <p>{item.a}</p>
            )}
          </details>
        ))}
      </div>
    </div>
    <div class="faq-art">
      <span class="disc disc-faq">
        <span class="faq-figure boil" data-boil data-faq role="img" aria-label="Ocy looking up, with question marks around its head">
          {faqArt.map((v, i) => (
            <span class="boil-v" data-on={i === 0 ? 'true' : undefined} aria-hidden="true">
              <span class="mascot-light" set:html={v.light} />
              <span class="mascot-dark" set:html={v.dark} />
            </span>
          ))}
        </span>
      </span>
    </div>
  </section>

  <script is:inline>
    (() => {
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* ---------- stepped frame player ---------- */
      const stages = Array.from(document.querySelectorAll('[data-mascot]'));
      const stateMap = new WeakMap();

      function showFrame(el, frameNum) {
        for (const frame of el.querySelectorAll('.mascot-frame')) {
          if (Number(frame.getAttribute('data-frame')) === frameNum) frame.setAttribute('data-active', 'true');
          else frame.removeAttribute('data-active');
        }
      }
      function stopStage(el) {
        const st = stateMap.get(el);
        if (st && st.timer !== null) {
          clearInterval(st.timer);
          st.timer = null;
        }
      }
      function freezeStage(el) {
        stopStage(el);
        const st = stateMap.get(el);
        if (!st) return;
        st.index = 0;
        showFrame(el, st.frozen);
      }
      function startStage(el) {
        const st = stateMap.get(el);
        if (!st || st.timer !== null) return;
        if (motionQuery.matches || document.hidden || !st.visible) return;
        if (st.sequence.length <= 1) {
          showFrame(el, st.sequence[0] ?? st.frozen);
          return;
        }
        st.timer = window.setInterval(() => {
          st.index = (st.index + 1) % st.sequence.length;
          showFrame(el, st.sequence[st.index]);
        }, st.stepMs);
      }
      for (const el of stages) {
        let sequence = [1];
        try {
          const parsed = JSON.parse(el.getAttribute('data-sequence') || '[1]');
          if (Array.isArray(parsed) && parsed.length > 0) sequence = parsed;
        } catch {
          sequence = [1];
        }
        const stepMs = Math.max(80, Number(el.getAttribute('data-step-ms') || '300'));
        const frozen = Number(el.getAttribute('data-frozen') || '1');
        stateMap.set(el, { sequence, stepMs, frozen, index: 0, timer: null, visible: false });
      }
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target;
            const st = stateMap.get(el);
            if (!st) continue;
            st.visible = entry.isIntersecting;
            if (motionQuery.matches) freezeStage(el);
            else if (st.visible && !document.hidden) startStage(el);
            else stopStage(el);
          }
        },
        { threshold: 0.05 }
      );
      for (const el of stages) observer.observe(el);
      function syncAll() {
        for (const el of stages) {
          const st = stateMap.get(el);
          if (motionQuery.matches) freezeStage(el);
          else if (st && st.visible && !document.hidden) startStage(el);
          else stopStage(el);
        }
      }
      motionQuery.addEventListener('change', syncAll);
      document.addEventListener('visibilitychange', syncAll);

      /* ---------- hand-drawn life: line boil, blinks, wiggling marks (stepped, never tweened) ---------- */
      const rand = (lo, hi) => lo + Math.random() * (hi - lo);
      const still = () => motionQuery.matches || document.hidden;
      function makeLife(el, opts) {
        const vs = Array.from(el.querySelectorAll('.boil-v'));
        let cur = 0;
        let visible = false;
        let blinkT = null;
        let boilT = null;
        function boil() {
          if (vs.length < 2) return;
          let n = cur;
          while (n === cur) n = Math.floor(Math.random() * vs.length);
          vs[cur].removeAttribute('data-on');
          vs[n].setAttribute('data-on', 'true');
          cur = n;
        }
        function blink() {
          el.setAttribute('data-blink', 'true');
          setTimeout(() => el.removeAttribute('data-blink'), Math.round(rand(120, 180)));
        }
        function loopBlink() {
          clearTimeout(blinkT);
          blinkT = setTimeout(() => {
            if (visible && !still() && opts.canBlink()) blink();
            loopBlink();
          }, rand(3000, 6000));
        }
        function loopBoil() {
          clearTimeout(boilT);
          boilT = setTimeout(() => {
            if (visible && !still() && opts.idleBoil()) boil();
            loopBoil();
          }, rand(opts.boilLo, opts.boilHi));
        }
        function reset() {
          vs.forEach((v, i) => (i === 0 ? v.setAttribute('data-on', 'true') : v.removeAttribute('data-on')));
          cur = 0;
          el.removeAttribute('data-blink');
        }
        new IntersectionObserver((en) => { visible = en[0].isIntersecting; }, { threshold: 0.05 }).observe(el);
        loopBlink();
        loopBoil();
        motionQuery.addEventListener('change', () => { if (motionQuery.matches) reset(); });
        return { boil, el };
      }

      /* ---------- hero: eyes follow the pointer, in jumps ---------- */
      const hero = document.querySelector('[data-hero]');
      if (hero) {
        const fig = hero.querySelector('[data-boil]');
        const eyes = Array.from(hero.querySelectorAll('.ocy-eyes, .ocy-blink'));
        let lastMove = -1e9;
        let lastBoil = 0;
        let boilGap = 320;
        const life = makeLife(fig, {
          canBlink: () => performance.now() - lastMove > 1200,
          idleBoil: () => performance.now() - lastMove > 1200 && Math.random() < 0.35,
          boilLo: 1400,
          boilHi: 2600,
        });
        let last = 0;
        let lastKey = '';
        let pending = null;
        let trailing = null;
        // The drawn eyes rest left of the head centre on purpose. Offsets are taken around the head centre
        // (bias), so the far-left and far-right looks sit about equally far from the middle of the face.
        const BX = 2.0, DX = 2.6, BY = 1.3, DY = 2.0;
        function place(dx, dy) {
          const key = dx + ',' + dy;
          if (key === lastKey) return;
          lastKey = key;
          for (const g of eyes) g.setAttribute('transform', `translate(${dx} ${dy})`);
        }
        window.addEventListener(
          'pointermove',
          (ev) => {
            if (ev.pointerType !== 'mouse' && ev.pointerType !== 'pen') return;
            if (motionQuery.matches) return;
            const now = performance.now();
            if (now - last < 125) {
              pending = ev;
              if (!trailing) trailing = setTimeout(() => { trailing = null; if (pending) { const e = pending; pending = null; aim(e); } }, 125 - (now - last));
              return;
            }
            pending = null;
            if (trailing) { clearTimeout(trailing); trailing = null; }
            aim(ev);
          },
          { passive: true }
        );
        function aim(ev) {
          const now = performance.now();
          last = now;
          const head = fig.querySelector('.boil-v[data-on] .ocy-head');
          const box = head && head.getClientRects().length ? head : fig;
          const r = box.getBoundingClientRect();
          if (r.bottom < 0 || r.top > window.innerHeight) return;
          lastMove = now;
          if (now - lastBoil > boilGap) { life.boil(); lastBoil = now; boilGap = rand(250, 400); }
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height / 2;
          const vx = ev.clientX - cx;
          const vy = ev.clientY - cy;
          if (Math.hypot(vx, vy) < r.width * 0.3) place(0, 0);
          else {
            const oct = Math.round(Math.atan2(vy, vx) / (Math.PI / 4));
            const a = oct * (Math.PI / 4);
            const c = Math.abs(Math.cos(a)) < 1e-9 ? 0 : Math.cos(a);
            const sn = Math.abs(Math.sin(a)) < 1e-9 ? 0 : Math.sin(a);
            place(Math.round((BX + c * DX) * 10) / 10, Math.round((BY + sn * DY) * 10) / 10);
          }
        }
        motionQuery.addEventListener('change', () => { if (motionQuery.matches) { lastKey = ''; place(0, 0); } });
      }

      /* ---------- FAQ: boil, blink, each question mark wiggles on its own rhythm ---------- */
      const faqFig = document.querySelector('[data-faq]');
      if (faqFig) {
        makeLife(faqFig, { canBlink: () => true, idleBoil: () => true, boilLo: 280, boilHi: 520 });
        const steps = [[-7, 0, 8, 0], [10, -4, 10, 3], [-5, 6, -9, 4, 0], [6, -10, 0]];
        const rhythm = [430, 560, 650, 500];
        let faqVisible = false;
        new IntersectionObserver((en) => { faqVisible = en[0].isIntersecting; }, { threshold: 0.05 }).observe(faqFig);
        steps.forEach((angles, i) => {
          const gs = Array.from(faqFig.querySelectorAll(`.ocy-q[data-q="${i}"]`));
          let k = 0;
          setInterval(() => {
            if (still()) { for (const g of gs) g.removeAttribute('transform'); return; }
            if (!faqVisible) return;
            k = (k + 1) % angles.length;
            for (const g of gs) g.setAttribute('transform', `rotate(${angles[k]})`);
          }, rhythm[i]);
        });
      }

      /* ---------- exercise slideshow ---------- */
      const show = document.querySelector('[data-slideshow]');
      if (show) {
        const slides = Array.from(show.querySelectorAll('[data-slide]'));
        const thumbs = Array.from(show.querySelectorAll('[data-go]'));
        const announce = show.querySelector('[data-announce]');
        let current = 0;
        let timer = null;
        let hovered = false;
        let focused = false;
        let onScreen = false;
        function go(i, speak) {
          current = (i + slides.length) % slides.length;
          slides.forEach((s, n) => (n === current ? s.setAttribute('data-active', 'true') : s.removeAttribute('data-active')));
          thumbs.forEach((t, n) => (n === current ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
          if (speak && announce) announce.textContent = slides[current].getAttribute('aria-label') || '';
        }
        function tick() {
          stop();
          if (motionQuery.matches || hovered || focused || !onScreen || document.hidden) return;
          timer = setTimeout(() => {
            go(current + 1, false);
            tick();
          }, 6000);
        }
        function stop() {
          if (timer !== null) clearTimeout(timer);
          timer = null;
        }
        thumbs.forEach((t, n) =>
          t.addEventListener('click', () => {
            go(n, true);
            tick();
          })
        );
        show.addEventListener('pointerenter', () => { hovered = true; stop(); });
        show.addEventListener('pointerleave', () => { hovered = false; tick(); });
        show.addEventListener('focusin', () => { focused = true; stop(); });
        show.addEventListener('focusout', (e) => {
          if (!show.contains(e.relatedTarget)) { focused = false; tick(); }
        });
        new IntersectionObserver((en) => { onScreen = en[0].isIntersecting; tick(); }, { threshold: 0.3 }).observe(show);
        motionQuery.addEventListener('change', tick);
        document.addEventListener('visibilitychange', tick);
      }

      /* ---------- app scene tabs ---------- */
      const tabs = Array.from(document.querySelectorAll('[data-tab]'));
      function selectTab(tab, focus) {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          const id = t.getAttribute('data-tab');
          document.getElementById('scene-' + id).hidden = !on;
          const note = document.querySelector(`[data-note="${id}"]`);
          if (note) note.hidden = !on;
        }
        if (focus) tab.focus();
      }
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => selectTab(t, false));
        t.addEventListener('keydown', (e) => {
          let n = null;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % tabs.length;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = tabs.length - 1;
          if (n !== null) {
            e.preventDefault();
            selectTab(tabs[n], true);
          }
        });
      });
    })();
  </script>
</BaseLayout>
