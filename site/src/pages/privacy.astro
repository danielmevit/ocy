---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Privacy — Ocy';
const pageDescription =
  'Ocy collects nothing, has no network code, and stores settings locally in %APPDATA%\\Ocy.';
const repoUrl = 'https://github.com/danielmevit/ocy';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/privacy/"
  includeOgImage={false}
>
  <section class="prose-band" aria-labelledby="privacy-heading">
    <div class="section-head">
      <h1 id="privacy-heading">Privacy</h1>
      <p class="section-sub">Ocy runs entirely on your own PC.</p>
    </div>

    <p class="prose-lede">
      Ocy collects nothing. There is no account, no telemetry, no crash reporting, no advertising, and no network code
      in the application at all. Nothing leaves your PC.
    </p>

    <div class="prose-grid">
      <article class="prose-card">
        <h2>What is stored on your PC</h2>
        <p>
          Ocy stores only your preferences (break intervals, durations, theme and behaviour options) locally in{' '}
          <code>%APPDATA%\Ocy</code>. To remove all saved settings, quit Ocy from the tray and delete that folder.
        </p>
      </article>

      <article class="prose-card">
        <h2>How activity is checked</h2>
        <p>
          To count active screen time and pause during fullscreen apps, Ocy checks idle time, lock and sleep session
          events, and fullscreen state locally on your PC. Nothing is logged or sent over the network.
        </p>
      </article>

      <article class="prose-card">
        <h2>This website</h2>
        <p>
          This site is static HTML hosted on GitHub Pages. It sets no cookies, runs no analytics, and makes zero
          external requests &mdash; no third-party fonts, CDNs or embeds.
        </p>
      </article>

      <article class="prose-card">
        <h2>Open source</h2>
        <p>
          Ocy is licensed under AGPL-3.0. You can inspect the full source code on{' '}
          <a href={repoUrl}>GitHub</a> or <a href={`${base}/`}>return to the main page</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
