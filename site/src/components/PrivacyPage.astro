---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageHref, rawTemplate, splitTemplateParts, t } from '../lib/i18n';
import { REPO_URL } from '../lib/ocyData';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const pageTitle = t(lang, 'privacy.meta.title');
const pageDescription = t(lang, 'privacy.meta.description');
const repoUrl = REPO_URL;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = pageHref(base, lang, 'home');

const storedIntroParts = splitTemplateParts(rawTemplate(lang, 'privacy.stored.intro'));
const usageOffParts = splitTemplateParts(rawTemplate(lang, 'privacy.usage.off'));
const supportEmail = 'support@damt.xyz';
const openSourceParts = splitTemplateParts(rawTemplate(lang, 'privacy.opensource.body'));
---

<BaseLayout
  lang={lang}
  pageType="privacy"
  title={pageTitle}
  description={pageDescription}
  includeOgImage={false}
>
  <section class="prose-band" aria-labelledby="privacy-heading">
    <div class="section-head">
      <h1 id="privacy-heading">{t(lang, 'privacy.heading')}</h1>
      <p class="section-sub">{t(lang, 'privacy.sub')}</p>
    </div>

    <p class="prose-lede">
      {t(lang, 'privacy.lede')}
    </p>

    <article class="prose-card prose-usage" id="usage-stats" aria-labelledby="usage-stats-heading">
      <h2 id="usage-stats-heading">{t(lang, 'privacy.usage.heading')}</h2>
      <p>{t(lang, 'privacy.usage.intro')}</p>
      <p>{t(lang, 'privacy.usage.listIntro')}</p>
      <ul class="usage-list">
        <li>{t(lang, 'privacy.usage.item.counts')}</li>
        <li>{t(lang, 'privacy.usage.item.settings')}</li>
        <li>{t(lang, 'privacy.usage.item.system')}</li>
        <li>{t(lang, 'privacy.usage.item.id')}</li>
      </ul>
      <p>{t(lang, 'privacy.usage.never')}</p>
      <p>{t(lang, 'privacy.usage.where')}</p>
      <p>
        {usageOffParts.map((part) =>
          part.type === 'text' ? (
            part.value
          ) : part.name === 'support' ? (
            <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
          ) : null
        )}
      </p>
    </article>

    <div class="prose-grid">
      <article class="prose-card">
        <h2>{t(lang, 'privacy.stored.heading')}</h2>
        <p>
          {storedIntroParts.map((part) =>
            part.type === 'text' ? (
              part.value
            ) : part.name === 'appdata' ? (
              <code>%APPDATA%\Ocy</code>
            ) : null
          )}
        </p>
        <ul class="file-list">
          <li><code>settings.json</code><span>{t(lang, 'privacy.stored.settings')}</span></li>
          <li><code>state.json</code><span>{t(lang, 'privacy.stored.state')}</span></li>
          <li><code>stats.json</code><span>{t(lang, 'privacy.stored.stats')}</span></li>
          <li><code>ocy-errors.log</code><span>{t(lang, 'privacy.stored.errors')}</span></li>
          <li><code>usage-stats.json</code><span>{t(lang, 'privacy.stored.usage')}</span></li>
        </ul>
        <p>{t(lang, 'privacy.stored.outro')}</p>
      </article>

      <article class="prose-card">
        <h2>{t(lang, 'privacy.activity.heading')}</h2>
        <p>{t(lang, 'privacy.activity.body')}</p>
      </article>

      <article class="prose-card">
        <h2>{t(lang, 'privacy.website.heading')}</h2>
        <p>{t(lang, 'privacy.website.body')}</p>
      </article>

      <article class="prose-card">
        <h2>{t(lang, 'privacy.ai.heading')}</h2>
        <p>{t(lang, 'privacy.ai.body1')}</p>
        <p>{t(lang, 'privacy.ai.body2')}</p>
        <p>{t(lang, 'privacy.ai.body3')}</p>
      </article>

      <article class="prose-card">
        <h2>{t(lang, 'privacy.opensource.heading')}</h2>
        <p>
          {openSourceParts.map((part) =>
            part.type === 'text' ? (
              part.value
            ) : part.name === 'github' ? (
              <a href={repoUrl}>{t(lang, 'nav.github')}</a>
            ) : part.name === 'homeLink' ? (
              <a href={homeHref}>{t(lang, 'privacy.opensource.homeLink')}</a>
            ) : null
          )}
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
