// Ocy's UI surfaces. Every string is an input property (the host localises); every action is a callback.
// Layout mirrors the approved C# (Avalonia) windows in src/Ocy.Desktop/Windows.
import { Theme } from "@app-theme/theme.slint";
import { Button, ButtonKind, CloseButton, Card, ProgressLine } from "@damt-ui/kit.slint";

export { Theme }
export { SettingsWindowV2, TimelineMark, TimelineMarkKind, SilentGame } from "settings_v2.slint";

// Exercise illustration slot: the host renders and animates the frames.
component Art inherits Image {
    in property <length> size;
    width: root.size;
    height: root.size;
    image-fit: contain;
    // Decorative: the exercise title and text carry the meaning.
    accessible-role: none;
}

// Short-break corner card (392 px window, 16 px transparent margin around the card).
export component ShortBreakCard inherits Window {
    in property <string> font-family: "Segoe UI";
    in property <image> art;
    in property <string> heading;
    in property <string> body;
    in property <float> progress;
    in property <string> close-label;
    in property <bool> dim-backdrop: false;
    // Gentle game card: "Not during this game", and on the gentle long card "Take the long break".
    in property <bool> show-hold-game: false;
    in property <string> hold-game-label;
    in property <bool> show-take-long: false;
    in property <string> take-long-label;
    callback close-clicked();
    callback hold-game-clicked();
    callback take-long-clicked();
    // Transparent margin around the card (holds the Slint drop shadow). macOS sets 0: its software
    // renderer has no per-pixel alpha, so the window is exactly the card and AppKit draws the
    // rounded corners and shadow.
    in property <length> card-inset: 16px;
    // Logical height the window needs (card + 16 px margins); the host sizes the window to it.
    out property <length> content-height: frame.preferred-height;

    no-frame: true;
    always-on-top: true;
    background: root.card-inset == 0 ? Theme.surface : root.dim-backdrop ? Theme.overlay : transparent;
    width: 360px + 2 * root.card-inset;
    default-font-family: root.font-family;

    frame := VerticalLayout {
        padding: root.card-inset;
        Card {
            shadow: root.card-inset > 0;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: Theme.space-8;
                HorizontalLayout {
                    spacing: Theme.space-10;
                    VerticalLayout {
                        alignment: start;
                        Art { size: 56px; source: root.art; }
                    }
                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.space-4;
                        HorizontalLayout {
                            spacing: Theme.space-4;
                            Text {
                                text: root.heading;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                CloseButton {
                                    accessible-name: root.close-label;
                                    clicked => { root.close-clicked(); }
                                }
                            }
                        }
                        Text {
                            text: root.body;
                            font-size: Theme.font-size-label;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                // Quiet game actions. A lone text button lines its label up with the body text
                // (56 px art + 10 px gap - 8 px button padding); two buttons use the full width.
                if root.show-hold-game || root.show-take-long : HorizontalLayout {
                    padding-left: root.show-take-long ? 0px : 58px;
                    spacing: Theme.space-8;
                    alignment: start;
                    if root.show-take-long : Button {
                        kind: ButtonKind.outline;
                        text: root.take-long-label;
                        padding-y: 4px;
                        clicked => { root.take-long-clicked(); }
                    }
                    if root.show-hold-game : Button {
                        kind: ButtonKind.text;
                        text: root.hold-game-label;
                        padding-y: 4px;
                        clicked => { root.hold-game-clicked(); }
                    }
                }
                ProgressLine { progress: root.progress; accessible-name: root.heading; }
            }
        }
    }
}

// Long-break warning card. In strict mode the strict line replaces Postpone and Skip.
export component WarningCard inherits Window {
    in property <string> font-family: "Segoe UI";
    in property <string> heading;
    in property <string> start-now-label;
    in property <string> postpone-label;
    in property <string> skip-label;
    in property <string> strict-label;
    in property <bool> strict: false;
    in property <bool> can-postpone: true;
    callback start-now();
    callback postpone();
    callback skip();
    // Transparent margin around the card (holds the Slint drop shadow). macOS sets 0: its software
    // renderer has no per-pixel alpha, so the window is exactly the card and AppKit draws the
    // rounded corners and shadow.
    in property <length> card-inset: 16px;
    // Logical height the window needs (card + 16 px margins); the host sizes the window to it.
    out property <length> content-height: frame.preferred-height;

    no-frame: true;
    always-on-top: true;
    background: root.card-inset == 0 ? Theme.surface : transparent;
    width: 360px + 2 * root.card-inset;
    default-font-family: root.font-family;

    frame := VerticalLayout {
        padding: root.card-inset;
        Card {
            shadow: root.card-inset > 0;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: Theme.space-10;
                VerticalLayout {
                    spacing: Theme.space-4;
                    Text {
                        text: root.heading;
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.attention;
                        overflow: elide;
                    }
                    if root.strict : Text {
                        text: root.strict-label;
                        font-size: Theme.font-size-help;
                        color: Theme.attention;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-8;
                    alignment: start;
                    Button {
                        kind: ButtonKind.accent;
                        text: root.start-now-label;
                        clicked => { root.start-now(); }
                    }
                    if !root.strict && root.can-postpone : Button {
                        kind: ButtonKind.outline;
                        text: root.postpone-label;
                        clicked => { root.postpone(); }
                    }
                    if !root.strict : Button {
                        kind: ButtonKind.text;
                        text: root.skip-label;
                        clicked => { root.skip(); }
                    }
                }
            }
        }
    }
}

component Suggestion inherits HorizontalLayout {
    in property <image> art;
    in property <string> heading;
    in property <string> body;
    spacing: Theme.space-8;
    VerticalLayout {
        alignment: start;
        Art { size: 40px; source: root.art; }
    }
    VerticalLayout {
        alignment: start;
        spacing: Theme.space-2;
        Text {
            text: root.heading;
            font-size: Theme.font-size-label;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.body;
            font-size: Theme.font-size-label;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

// Long-break overlay: a dim full-screen backdrop with a 480 px card centred on it.
export component LongBreakCard inherits Window {
    in property <string> font-family: "Segoe UI";
    in property <string> countdown-label;
    in property <string> countdown;
    in property <string> heading;
    in property <string> body;
    in property <bool> show-suggestions: true;
    in property <image> suggestion1-art;
    in property <string> suggestion1-title;
    in property <string> suggestion1-body;
    in property <bool> show-suggestion2: true;
    in property <image> suggestion2-art;
    in property <string> suggestion2-title;
    in property <string> suggestion2-body;
    in property <float> progress;
    in property <string> end-label;
    in property <bool> can-end: true;
    in property <bool> dim-backdrop: true;
    callback end-break();
    // 0 on macOS: the window is exactly the 480 px card (no Slint drop shadow; AppKit draws the
    // rounded corners and shadow). Any other value keeps today's shadowed card in a larger window.
    in property <length> card-inset: 16px;
    // Logical height of the card content; the host sizes the card window around it.
    out property <length> content-height: content.preferred-height;

    no-frame: true;
    always-on-top: true;
    background: root.card-inset == 0 ? Theme.surface : root.dim-backdrop ? Theme.overlay : transparent;
    default-font-family: root.font-family;

    // Esc ends the break like the End break button (C#: Escape skips unless strict); keys from the
    // focused button bubble up here.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.can-end) { root.end-break(); return accept; }
            reject
        }

        Card {
            bordered: false;
            drop-shadow-blur: root.card-inset > 0 ? 32px : 0px;
            drop-shadow-offset-y: root.card-inset > 0 ? 8px : 0px;
            drop-shadow-color: root.card-inset > 0 ? #00000040 : transparent;
            width: 480px;
            height: content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            content := VerticalLayout {
                padding: 24px;
                Text {
                    text: root.countdown-label;
                    font-size: Theme.font-size-help;
                    color: Theme.text-muted;
                }
                Text {
                    text: root.countdown;
                    font-size: Theme.font-size-countdown;
                    font-weight: 300;
                    height: 64px;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                Rectangle { height: 16px; }
                Text {
                    text: root.heading;
                    font-size: Theme.font-size-title;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Rectangle { height: 2px; }
                Text {
                    text: root.body;
                    font-size: Theme.font-size-body;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    overflow: elide;
                }
                if root.show-suggestions : VerticalLayout {
                    padding-top: 16px;
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding-top: 10px;
                        spacing: 16px;
                        Suggestion {
                            horizontal-stretch: 1;
                            art: root.suggestion1-art;
                            heading: root.suggestion1-title;
                            body: root.suggestion1-body;
                        }
                        if root.show-suggestion2 : Suggestion {
                            horizontal-stretch: 1;
                            art: root.suggestion2-art;
                            heading: root.suggestion2-title;
                            body: root.suggestion2-body;
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 16px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        ProgressLine {
                            progress: root.progress;
                            accessible-name: root.countdown-label;
                            accessible-text: root.countdown;
                        }
                    }
                    if root.can-end : Button {
                        kind: ButtonKind.outline;
                        text: root.end-label;
                        padding-x: 12px;
                        padding-y: 5px;
                        clicked => { root.end-break(); }
                    }
                }
            }
        }
    }
}
