---
import '../styles/global.css';
import faviconSvg from '../../../assets/icons/brand/ocy-sprout-light.svg?url';
import sproutLight from '../../../assets/icons/brand/ocy-sprout-light.svg?url';
import sproutDark from '../../../assets/icons/brand/ocy-sprout-dark.svg?url';
import faviconPng from '../../../assets/icons/brand/png/ocy-sprout-light-32.png?url';
import {
  DEFAULT_LANG,
  type PageType,
  getAvailableLanguages,
  languageEndonym,
  ogLocaleFor,
  pageAbsoluteUrl,
  pageHref,
  rawTemplate,
  splitTemplateParts,
  t,
} from '../lib/i18n';
import { REPO_URL, STORE_URL } from '../lib/ocyData';

interface Props {
  lang: string;
  pageType: PageType;
  title: string;
  description: string;
  noindex?: boolean;
  includeOgImage?: boolean;
  ogImageAlt?: string;
}

const {
  lang,
  pageType,
  title,
  description,
  noindex = false,
  includeOgImage = true,
  ogImageAlt = t(lang, 'meta.defaultOgImageAlt'),
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = (Astro.site ? Astro.site.toString() : 'https://danielmevit.github.io').replace(/\/$/, '');
const isIndexable = pageType !== '404';
const canonicalUrl = isIndexable ? pageAbsoluteUrl(origin, base, lang, pageType) : undefined;
const ogImageUrl = `${origin}${base}/assets/og.png`;

const availableLangs = getAvailableLanguages();
const currentEndonym = languageEndonym(lang);
const homeHref = pageHref(base, lang, 'home');
const privacyHref = pageHref(base, lang, 'privacy');

const currentOgLocale = ogLocaleFor(lang);
const alternateOgLocales = Array.from(
  new Set(
    availableLangs
      .filter((alt) => alt !== lang)
      .map((alt) => ogLocaleFor(alt))
      .filter((loc) => loc !== currentOgLocale)
  )
);

const themeLabels = {
  auto: {
    aria: t(lang, 'theme.aria', { current: t(lang, 'theme.auto'), next: t(lang, 'theme.light') }),
    title: t(lang, 'theme.title', { current: t(lang, 'theme.auto') }),
  },
  light: {
    aria: t(lang, 'theme.aria', { current: t(lang, 'theme.light'), next: t(lang, 'theme.dark') }),
    title: t(lang, 'theme.title', { current: t(lang, 'theme.light') }),
  },
  dark: {
    aria: t(lang, 'theme.aria', { current: t(lang, 'theme.dark'), next: t(lang, 'theme.autoShort') }),
    title: t(lang, 'theme.title', { current: t(lang, 'theme.dark') }),
  },
};

const langCode = (tag: string) => tag.split('-')[0].toUpperCase();

const madeByParts = splitTemplateParts(rawTemplate(lang, 'footer.madeBy'));
const copyrightParts = splitTemplateParts(rawTemplate(lang, 'footer.copyright'));
const supportEmail = 'support@damt.xyz';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme before first paint: 'light' | 'dark' from localStorage, otherwise follow the OS (no attribute).
      try {
        var t = localStorage.getItem('ocy-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {isIndexable && availableLangs.map((alt) => (
      <link rel="alternate" hreflang={alt} href={pageAbsoluteUrl(origin, base, alt, pageType)} />
    ))}
    {isIndexable && (
      <link rel="alternate" hreflang="x-default" href={pageAbsoluteUrl(origin, base, DEFAULT_LANG, pageType)} />
    )}
    <link
      rel="alternate"
      type="text/plain"
      href={`${base}/llms.txt`}
      title={t(lang, 'meta.llmSummary')}
    />

    <meta name="description" content={description} />
    <meta name="author" content="Daniel Mevit" />
    <meta name="theme-color" content="#F6F7F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17191A" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={t(lang, 'brand.name')} />
    {includeOgImage && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
      </>
    )}
    <meta name="twitter:card" content={includeOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skipToContent')}</a>

    <span class="header-sentinel" aria-hidden="true"></span>
    <header class="site-header">
      <nav class="nav" aria-label={t(lang, 'nav.aria')}>
        <a class="brand" href={homeHref}>
          <img class="mascot-light" src={sproutLight} alt="" width="28" height="28" /><img class="mascot-dark" src={sproutDark} alt="" width="28" height="28" />
          <span>{t(lang, 'brand.name')}</span>
        </a>
        <div class="nav-links">
          <a class="nav-hide-sm" href={`${homeHref}#works`}>{t(lang, 'nav.howItWorks')}</a>
          <a class="nav-hide-sm" href={`${homeHref}#exercises`}>{t(lang, 'nav.exercises')}</a>
          <a class="nav-hide-sm" href={`${homeHref}#app`}>{t(lang, 'nav.theApp')}</a>
          <a class="nav-hide-sm" href={`${homeHref}#faq`}>{t(lang, 'nav.faq')}</a>
          <a class="nav-cta" href={STORE_URL} aria-label={t(lang, 'nav.store')}><span class="cta-long">{t(lang, 'nav.store')}</span><span class="cta-short" aria-hidden="true">{t(lang, 'nav.storeShort')}</span></a>
          <details class="lang-menu" data-lang-menu>
            <summary class="lang-btn" aria-label={t(lang, 'nav.languageAria', { language: currentEndonym })}>
              <span class="lang-name">{currentEndonym}</span>
              <span class="lang-code" aria-hidden="true">{langCode(lang)}</span>
              <svg class="lang-caret" viewBox="0 0 12 12" aria-hidden="true">
                <path class="ink" d="M2.5 4.5 L6 8 L9.5 4.5" style="stroke-width: 1.5;" />
              </svg>
            </summary>
            <ul class="lang-list" aria-label={t(lang, 'nav.languageMenuLabel')}>
              {availableLangs.map((alt) => (
                <li>
                  <a
                    href={pageHref(base, alt, pageType)}
                    lang={alt}
                    hreflang={alt}
                    aria-current={alt === lang ? 'page' : undefined}
                  >
                    <span>{languageEndonym(alt)}</span>
                    {alt === lang && (
                      <svg class="lang-check" viewBox="0 0 12 12" aria-hidden="true">
                        <path class="ink" d="M2.5 6.4 L5 8.8 L9.6 3.4" style="stroke-width: 1.6;" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <button
            type="button"
            class="theme-btn"
            data-theme-btn
            data-theme-labels={JSON.stringify(themeLabels)}
            aria-label={themeLabels.auto.aria}
          >
            <svg class="theme-glyph" viewBox="0 0 24 24" aria-hidden="true">
              <g class="g-auto"><path class="ink" d="M12 3.4 C7 3.2 3.3 7.2 3.5 12.2 C3.7 16.9 7.4 20.6 12.1 20.5" /><path class="ink" d="M12 3.4 C16.8 3.6 20.6 7.3 20.4 12.3 C20.2 16.9 16.7 20.4 12.1 20.5" /><path d="M12 3.6 C16.6 3.8 20.3 7.4 20.2 12.2 C20 16.7 16.6 20.2 12.1 20.3 Z" fill="currentColor" /></g>
              <g class="g-light"><path class="ink" d="M12.2 8.1 C9.8 8 8 10 8.1 12.2 C8.3 14.4 10 16 12.1 15.9 C14.3 15.8 16 14.1 15.9 12 C15.8 9.9 14.3 8.2 12.2 8.1Z" /><path class="ink" d="M12 2.8 L12.2 5 M12.1 19.1 L12 21.3 M2.9 12.1 L5.1 12 M18.9 12.2 L21.1 12 M5.4 5.6 L6.9 7.1 M17.2 17 L18.6 18.5 M18.5 5.5 L17 7 M6.9 17.1 L5.5 18.4" /></g>
              <g class="g-dark"><path class="ink" d="M15.8 3.9 C11 3.4 7 7.4 7.4 12.3 C7.8 16.8 11.6 20.3 16.2 19.9 C17.6 19.8 18.8 19.3 19.9 18.6 C15.6 18.4 12.4 15 12.5 10.8 C12.6 7.8 13.9 5.3 15.8 3.9Z" /></g>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-btn]');
        if (btn) {
          let labels = null;
          try {
            const raw = btn.getAttribute('data-theme-labels');
            if (raw) labels = JSON.parse(raw);
          } catch (e) {}
          const root = document.documentElement;
          const order = ['auto', 'light', 'dark'];
          const current = () => root.getAttribute('data-theme') || 'auto';
          const label = () => {
            const c = current();
            if (labels && labels[c]) {
              btn.setAttribute('aria-label', labels[c].aria);
              btn.setAttribute('title', labels[c].title);
            }
            btn.setAttribute('data-state', c);
          };
          btn.addEventListener('click', () => {
            const n = order[(order.indexOf(current()) + 1) % order.length];
            if (n === 'auto') root.removeAttribute('data-theme');
            else root.setAttribute('data-theme', n);
            try {
              if (n === 'auto') localStorage.removeItem('ocy-theme');
              else localStorage.setItem('ocy-theme', n);
            } catch (e) {}
            label();
          });
          label();
        }

        const menu = document.querySelector('[data-lang-menu]');
        if (menu) {
          document.addEventListener('click', (e) => {
            if (menu.open && !menu.contains(e.target)) menu.open = false;
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && menu.open) {
              menu.open = false;
              menu.querySelector('summary')?.focus();
            }
          });
        }

      })();
    </script>

    <footer class="site-footer" aria-label={t(lang, 'footer.aria')}>
      <div class="footer-brand">
        <a class="brand" href={homeHref}>
          <img class="mascot-light" src={sproutLight} alt="" width="24" height="24" /><img class="mascot-dark" src={sproutDark} alt="" width="24" height="24" />
          <span>{t(lang, 'brand.name')}</span>
        </a>
        <a class="slint-badge" href="https://slint.dev">
          <img class="mascot-light" src={`${base}/assets/slint/MadeWithSlint-logo-dark.svg`} width="106" height="49" alt="Made with Slint" />
          <img class="mascot-dark" src={`${base}/assets/slint/MadeWithSlint-logo-light.svg`} width="106" height="49" alt="Made with Slint" />
        </a>
      </div>
      <div class="footer-group">
        <h2 class="footer-head">{t(lang, 'footer.getOcy')}</h2>
        <ul>
          <li><a href={STORE_URL}>{t(lang, 'footer.store')}</a></li>
          <li><a href={REPO_URL}>{t(lang, 'footer.source')}</a></li>
        </ul>
      </div>
      <div class="footer-group">
        <h2 class="footer-head">{t(lang, 'footer.help')}</h2>
        <ul>
          <li><span class="footer-label">{t(lang, 'footer.support')}</span> <a href={`mailto:${supportEmail}`}>{supportEmail}</a></li>
          <li><a href={privacyHref}>{t(lang, 'footer.privacy')}</a></li>
        </ul>
      </div>
      <div class="footer-group">
        <h2 class="footer-head">{t(lang, 'footer.about')}</h2>
        <ul>
          <li>{madeByParts.map((part) => part.type === 'text' ? part.value : part.name === 'maker' ? <a href="https://damt.xyz">damt.xyz</a> : null)}</li>
          <li>{copyrightParts.map((part) => part.type === 'text' ? part.value : part.name === 'author' ? 'damt.xyz' : null)}</li>
        </ul>
      </div>
    </footer>
      <script is:inline>
      // Sticky header: show its hairline once the top-of-page sentinel scrolls out of view.
      (() => {
        const header = document.querySelector('.site-header');
        const sentinel = document.querySelector('.header-sentinel');
        if (!header || !sentinel || !('IntersectionObserver' in window)) return;
        new IntersectionObserver(([e]) => header.classList.toggle('is-stuck', !e.isIntersecting)).observe(sentinel);
      })();
    </script>
</body>
</html>
