<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Ocy.Desktop.Controls"
        x:Class="Ocy.Desktop.Windows.ShortBreakWindow"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="392"
        SizeToContent="Height">
    <Panel x:Name="RootPanel">
        <Panel x:Name="OverlayBackdrop"
               Background="{DynamicResource OverlayBrush}"
               IsVisible="False" />
        <Border x:Name="CardBorder"
                Margin="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                BoxShadow="0 4 16 0 #2A000000">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <ctl:ExerciseIllustration x:Name="Illustration"
                                              Grid.Column="0"
                                              Size="56"
                                              VerticalAlignment="Top"
                                              Margin="0,0,10,0" />
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                            <TextBlock x:Name="TitleText"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button x:Name="SkipButton"
                                    Grid.Column="1"
                                    Classes="text"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <TextBlock x:Name="BodyText"
                                   Grid.Row="1"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </Grid>
                </Grid>

                <ProgressBar x:Name="BreakProgressBar"
                             Grid.Row="1"
                             Height="3"
                             CornerRadius="1.5"
                             Minimum="0"
                             Maximum="100"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource ProgressBarTrackBrush}" />
            </Grid>
        </Border>
    </Panel>
</Window>
