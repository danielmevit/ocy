# Desktop entry for Ocy (installed to /app/share/applications/xyz.damt.ocy.desktop).
# Spec: https://specifications.freedesktop.org/desktop-entry-spec/latest/
# ocy-app calls slint::set_xdg_app_id("xyz.damt.ocy"), setting xdg_toplevel.app_id
# on Wayland and WM_CLASS = ("", "xyz.damt.ocy") on X11 via winit 0.30.
[Desktop Entry]
Type=Application
Name=Ocy
GenericName=Break reminder
Comment=Calm break reminders for your eyes
Exec=Ocy
Icon=xyz.damt.ocy
Terminal=false
Categories=Utility;Accessibility;
Keywords=health;eyes;break;rest;reminder;stretch;
StartupWMClass=xyz.damt.ocy
X-KDE-StartupNotify=false
# Single instance: a second launch signals the running instance to open Settings
# (damt-app SingleInstance), so keep launching cheap and quiet.
StartupNotify=false
