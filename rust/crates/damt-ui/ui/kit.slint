// damt-ui: the app-neutral component kit. Colours and sizes come from the consuming app's generated
// `Theme` global, mapped by the app's build script as the `@app-theme` library path.
// Compact density, no italics anywhere, focus ring in Accent.
import { Theme } from "@app-theme/theme.slint";

export enum ButtonKind { accent, outline, text }

// Button with three classes: accent (filled), outline (1 px muted border), text (muted label only).
export component Button inherits Rectangle {
    in property <string> text;
    in property <ButtonKind> kind: ButtonKind.outline;
    in property <bool> enabled: true;
    in property <length> font-size: Theme.font-size-label;
    in property <int> font-weight: kind == ButtonKind.accent ? 600 : 400;
    in property <length> padding-x: kind == ButtonKind.accent ? 12px : kind == ButtonKind.outline ? 10px : 8px;
    in property <length> padding-y: 6px;
    in property <length> fixed-width: 0px;
    in property <length> fixed-height: 0px;
    in property <string> accessible-name: root.text;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback clicked();

    min-width: root.fixed-width > 0 ? root.fixed-width : label.preferred-width + 2 * root.padding-x;
    max-width: root.fixed-width > 0 ? root.fixed-width : 100000px;
    min-height: root.fixed-height > 0 ? root.fixed-height : label.preferred-height + 2 * root.padding-y;
    max-height: root.fixed-height > 0 ? root.fixed-height : 100000px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    border-radius: Theme.radius-button;
    border-width: root.kind == ButtonKind.outline ? 1px : 0px;
    border-color: Theme.text-muted;
    background: root.kind == ButtonKind.accent
        ? (!root.enabled ? Theme.accent : touch.pressed ? Theme.button-accent-pressed : touch.has-hover ? Theme.button-accent-hover : Theme.accent)
        : root.kind == ButtonKind.outline
            ? (!root.enabled ? transparent : touch.pressed ? Theme.button-outline-pressed : touch.has-hover ? Theme.button-outline-hover : transparent)
            : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    label := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-italic: false;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.kind == ButtonKind.accent ? Theme.on-accent
            : root.kind == ButtonKind.outline ? Theme.text
            : (root.enabled && (touch.has-hover || touch.pressed) ? Theme.text : Theme.text-muted);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    // Focus ring: 2 px Accent, 3 px outside the button.
    if focus.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.radius-button + 3px;
    }
}

// Close button: a drawn × (no font glyph, so it never depends on font coverage), 28 x 28,
// muted, Text colour on hover/pressed, keyboard focus ring in Accent.
export component CloseButton inherits Rectangle {
    in property <string> accessible-name;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: Theme.radius-button;
    background: touch.pressed ? Theme.button-outline-pressed : touch.has-hover ? Theme.button-outline-hover : transparent;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Path {
        width: 10px;
        height: 10px;
        commands: "M0 0 L10 10 M10 0 L0 10";
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: (touch.has-hover || touch.pressed) ? Theme.text : Theme.text-muted;
        stroke-width: 1.2px;
        fill: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.radius-button + 3px;
    }
}

// "Try …" link: left-aligned accent text with pointer cursor, hover underline, pressed darker accent,
// and keyboard focus ring consistent with the kit's other focusable controls.
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font-size: Theme.font-size-label;
    in property <int> font-weight: 400;
    in property <length> padding-x: 0px;
    in property <length> padding-y: 6px;
    in property <length> fixed-width: 0px;
    in property <length> fixed-height: 0px;
    in property <string> accessible-name: root.text;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback clicked();

    property <color> link-color: !root.enabled ? Theme.accent
        : touch.pressed ? Theme.system-accent-dark-1
        : Theme.accent;

    min-width: root.fixed-width > 0 ? root.fixed-width : label.preferred-width + 2 * root.padding-x;
    max-width: root.fixed-width > 0 ? root.fixed-width : 100000px;
    min-height: root.fixed-height > 0 ? root.fixed-height : label.preferred-height + 2 * root.padding-y;
    max-height: root.fixed-height > 0 ? root.fixed-height : 100000px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    label := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-italic: false;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.link-color;
    }

    if root.enabled && (touch.has-hover || touch.pressed) : Rectangle {
        x: (parent.width - label.preferred-width) / 2;
        y: (parent.height + label.preferred-height) / 2 - 1px;
        width: label.preferred-width;
        height: 1px;
        background: root.link-color;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    // Focus ring: 2 px Accent, 3 px outside the link.
    if focus.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.radius-button + 3px;
    }
}

// Card surface: Surface fill, 8 px radius, optional 1 px border and drop shadow.
export component Card inherits Rectangle {
    in property <bool> bordered: true;
    in property <bool> shadow: true;
    background: Theme.surface;
    border-radius: Theme.radius-card;
    border-width: root.bordered ? 1px : 0px;
    border-color: Theme.border;
    // 10 px blur + 4 px offset stays inside a 16 px window margin (Avalonia's 16 px blur is a softer
    // Gaussian of similar reach).
    drop-shadow-blur: root.shadow ? 10px : 0px;
    drop-shadow-offset-y: root.shadow ? 4px : 0px;
    drop-shadow-color: root.shadow ? #0000002A : transparent;
}

// Toggle switch, 40 x 20. Both states stay in the accent family: off = accent outline + accent knob,
// on = accent fill + surface knob. Hover = accent light-1, pressed = accent dark-1.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback toggled(bool);

    width: 40px;
    height: 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.4;

    property <color> tone: !root.enabled ? Theme.accent
        : touch.pressed ? Theme.system-accent-dark-1
        : touch.has-hover ? Theme.system-accent-light-1
        : Theme.accent;

    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.flip(); } }

    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    track := Rectangle {
        border-radius: Theme.radius-toggle;
        border-width: 1px;
        border-color: root.tone;
        background: root.checked ? root.tone : transparent;
    }

    knob := Rectangle {
        width: 10px;
        height: 10px;
        y: 5px;
        x: root.checked ? root.width - 15px : 5px;
        border-radius: 5px;
        background: root.checked ? Theme.surface : root.tone;
        animate x { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.flip();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.radius-toggle + 3px;
    }
}

// Whole-number field, 92 x 28, with stacked up/down chevrons on the right and a unit label after it.
export component NumberField inherits HorizontalLayout {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <string> unit;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback edited(int);

    spacing: Theme.space-6;
    alignment: start;

    function set-value(v: int) {
        root.value = Math.clamp(v, root.minimum, root.maximum);
        root.edited(root.value);
    }

    box := Rectangle {
        width: 92px;
        height: 28px;
        border-radius: Theme.radius-button;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : (hover.has-hover && root.enabled) ? Theme.text-muted : Theme.border;
        opacity: root.enabled ? 1.0 : 0.5;
        clip: true;

        // The box is the spin button for screen readers; the inner TextInput is hidden from the tree.
        accessible-role: spinbox;
        accessible-label: root.accessible-name;
        accessible-enabled: root.enabled;
        accessible-value: root.unit != "" ? root.value + " " + root.unit : root.value;
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        accessible-value-step: 1;
        accessible-action-increment => { if (root.enabled) { root.set-value(root.value + 1); input.text = root.value; } }
        accessible-action-decrement => { if (root.enabled) { root.set-value(root.value - 1); input.text = root.value; } }
        accessible-action-set-value(v) => {
            if (root.enabled && v.is-float()) { root.set-value(v.to-float().round()); input.text = root.value; }
        }

        hover := TouchArea { enabled: root.enabled; }

        input := TextInput {
            x: 8px;
            width: parent.width - 8px - 18px - 4px;
            height: parent.height;
            vertical-alignment: center;
            font-size: Theme.font-size-label;
            color: Theme.text;
            selection-background-color: Theme.system-accent-light-3;
            input-type: number;
            enabled: root.enabled;
            text: root.value;
            accessible-role: none;
            accepted => { root.set-value(self.text.to-float().round()); self.text = root.value; }
            changed has-focus => {
                if (!self.has-focus) { root.set-value(self.text.to-float().round()); self.text = root.value; }
            }
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.set-value(root.value + 1); self.text = root.value; return accept; }
                if (event.text == Key.DownArrow) { root.set-value(root.value - 1); self.text = root.value; return accept; }
                reject
            }
        }

        spin := VerticalLayout {
            x: parent.width - 18px - 1px;
            y: 1px;
            width: 18px;
            height: parent.height - 2px;

            Rectangle {
                background: up.pressed ? Theme.button-outline-pressed : up.has-hover ? Theme.button-outline-hover : transparent;
                Path {
                    width: 8px;
                    height: 4px;
                    commands: "M0 4 L4 0 L8 4";
                    viewbox-width: 8;
                    viewbox-height: 4;
                    stroke: Theme.text-muted;
                    stroke-width: 1.2px;
                    fill: transparent;
                }
                up := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: pointer;
                    clicked => { root.set-value(root.value + 1); input.text = root.value; }
                }
            }
            Rectangle {
                background: down.pressed ? Theme.button-outline-pressed : down.has-hover ? Theme.button-outline-hover : transparent;
                Path {
                    width: 8px;
                    height: 4px;
                    commands: "M0 0 L4 4 L8 0";
                    viewbox-width: 8;
                    viewbox-height: 4;
                    stroke: Theme.text-muted;
                    stroke-width: 1.2px;
                    fill: transparent;
                }
                down := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: pointer;
                    clicked => { root.set-value(root.value - 1); input.text = root.value; }
                }
            }
        }
    }

    if root.unit != "" : Text {
        text: root.unit;
        // Already part of the spin button's value.
        accessible-role: none;
        font-size: Theme.font-size-help;
        color: Theme.text-muted;
        vertical-alignment: center;
        opacity: root.enabled ? 1.0 : 0.5;
    }
}

// One settings row: label + help on the left, the control in a fixed 132 px column on the right,
// an optional 1 px divider above. Disabled rows stay visible at half opacity.
export component SettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <bool> show-divider: true;
    in property <bool> enabled: true;
    in property <bool> control-right: false;

    if root.show-divider : Rectangle { height: 1px; background: Theme.divider; }

    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        min-height: 44px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-2;
            opacity: root.enabled ? 1.0 : 0.5;
            Text {
                text: root.label;
                font-size: Theme.font-size-label;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.help != "" : Text {
                text: root.help;
                font-size: Theme.font-size-help;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            width: 132px;
            alignment: root.control-right ? end : start;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

// Section header: title + optional inline toggle on the right.
export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> has-toggle: false;
    in-out property <bool> checked;
    in property <string> toggle-accessible-name;
    callback toggled(bool);

    spacing: Theme.space-8;
    Text {
        text: root.title;
        font-size: Theme.font-size-body;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.has-toggle : VerticalLayout {
        alignment: center;
        Toggle {
            checked <=> root.checked;
            accessible-name: root.toggle-accessible-name;
            toggled(v) => { root.toggled(v); }
        }
    }
}

// Thin progress line: 3 px, rounded, Accent fill on the progress track. `progress` is 0..1.
// For screen readers it is a progress indicator 0..100; `accessible-text` (e.g. "4:12") replaces the
// percentage as the announced value when set.
export component ProgressLine inherits Rectangle {
    in property <float> progress;
    in property <string> accessible-name;
    in property <string> accessible-text;
    height: 3px;
    border-radius: 1.5px;
    background: Theme.progress-track;
    accessible-role: progress-indicator;
    accessible-label: root.accessible-name;
    accessible-value: root.accessible-text != "" ? root.accessible-text : Math.round(Math.clamp(root.progress, 0, 1) * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    Rectangle {
        x: 0;
        width: parent.width * Math.clamp(root.progress, 0, 1);
        height: parent.height;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}
